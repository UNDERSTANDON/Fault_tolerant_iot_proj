function(validate_local_gpio_mapping target sensor_pin relay_pin)
    foreach(pin IN ITEMS "${sensor_pin}" "${relay_pin}")
        if(NOT pin MATCHES "^-?[0-9]+$")
            message(FATAL_ERROR "GPIO role mapping must be an integer.")
        endif()
        if(pin EQUAL -1)
            continue()
        endif()
        if(NOT target STREQUAL "esp32s3")
            message(FATAL_ERROR "GPIO role assignments are supported only for the ESP32-S3 target.")
        endif()
        if(pin LESS 0 OR pin GREATER 48 OR (pin GREATER 21 AND pin LESS 26))
            message(FATAL_ERROR "GPIO ${pin} is not a GPIO number on the ESP32-S3.")
        endif()
    endforeach()

    if(NOT sensor_pin EQUAL -1 AND sensor_pin EQUAL relay_pin)
        message(FATAL_ERROR "Sensor input 1 and light relay 1 cannot share a GPIO.")
    endif()
endfunction()

function(validate_hardware_gpio_bundle target mq2_pin)
    set(assigned_pins "")
    set(all_pins "${mq2_pin}" ${ARGN})
    if(NOT mq2_pin STREQUAL "-1")
        if(NOT mq2_pin MATCHES "^-?[0-9]+$" OR mq2_pin LESS 1 OR mq2_pin GREATER 10)
            message(FATAL_ERROR "MQ-2 AO GPIO ${mq2_pin} must use ESP32-S3 ADC1 (GPIO1..GPIO10).")
        endif()
    endif()

    foreach(pin IN ITEMS ${all_pins})
        if(NOT pin MATCHES "^-?[0-9]+$")
            message(FATAL_ERROR "Hardware GPIO mapping '${pin}' must be an integer.")
        endif()
        if(pin EQUAL -1)
            continue()
        endif()
        if(NOT target STREQUAL "esp32s3")
            message(FATAL_ERROR "Hardware GPIO assignments are supported only for the ESP32-S3 target.")
        endif()
        if(pin LESS 0 OR pin GREATER 48 OR (pin GREATER 21 AND pin LESS 26))
            message(FATAL_ERROR "GPIO ${pin} is not a GPIO number on the ESP32-S3.")
        endif()
        list(FIND assigned_pins "${pin}" existing_index)
        if(NOT existing_index EQUAL -1)
            message(FATAL_ERROR "Duplicate hardware GPIO pin ${pin} detected.")
        endif()
        list(APPEND assigned_pins "${pin}")
    endforeach()
endfunction()
