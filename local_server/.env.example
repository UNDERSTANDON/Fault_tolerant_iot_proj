# Local-only Compose settings. Initialize-LocalBroker.ps1 creates .env for you.
BROKER_BIND_IP=127.0.0.1
BROKER_SECRETS_DIR=C:/Users/your-name/AppData/Local/FaultTolerantIoT/mosquitto/certs
LOCAL_BROKER_CREDENTIALS=C:/Users/your-name/AppData/Local/FaultTolerantIoT/mosquitto/bridge.env
BRIDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
